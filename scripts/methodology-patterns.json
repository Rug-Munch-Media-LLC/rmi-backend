{
	"version": 1,
	"authority": "standards/METHODOLOGY-PROTECTION.md",
	"note": "Detection SHAPES only. No internal hostnames, paths or vendor names belong in this file; it ships with the gate into public repos.",
	"extensions": [".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".vue", ".sol"],
	"skip_dirs": [
		".cache",
		".eggs",
		".git",
		".hypothesis",
		".mypy_cache",
		".next",
		".nuxt",
		".pytest_cache",
		".ruff_cache",
		".tox",
		".venv",
		"__fixtures__",
		"__pycache__",
		"__tests__",
		"build",
		"coverage",
		"dist",
		"docs",
		"env",
		"example",
		"examples",
		"fixtures",
		"migrations",
		"mutants",
		"mutations",
		"node_modules",
		"samples",
		"site-packages",
		"test",
		"testdata",
		"tests",
		"third_party",
		"vendor",
		"venv"
	],
	"skip_suffixes": [
		"_test.py",
		".test.ts",
		".test.tsx",
		".spec.ts",
		".spec.tsx",
		".stories.ts",
		".stories.tsx",
		".d.ts"
	],
	"skip_globs": ["test_*.py", "conftest.py"],
	"fixture_marker": "methodology-check: fixture",
	"rules": {
		"weight-map": {
			"enabled": true,
			"min_keys": 3,
			"min_share": 0.6,
			"min_vocab_keys": 2,
			"sum_low": 0.9,
			"sum_high": 1.1,
			"name_hint": "(?i)(weight|score|factor|signal|prior|rubric|model|formula|heuristic)",
			"vocabulary": [
				"liquidity",
				"holder",
				"dev",
				"wallet",
				"social",
				"volume",
				"tax",
				"mint",
				"freeze",
				"unlock",
				"bundler",
				"honeypot",
				"sniper",
				"insider",
				"cluster",
				"supply",
				"owner",
				"renounce"
			]
		},
		"magic-threshold": {
			"enabled": true,
			"name_hint": "(?i)(threshold|cutoff|cut_off|rug)",
			"ignore_literals": [0, 1, 100],
			"score_name_hint": "(?i)(score|risk|confidence|danger|severity|suspicious)"
		},
		"signal-list": {
			"enabled": true,
			"min_items": 4,
			"min_vocab_hits": 2,
			"vocabulary": [
				"dev",
				"deployer",
				"bundler",
				"honeypot",
				"sniper",
				"insider",
				"blacklist",
				"hidden",
				"renounce",
				"mint",
				"freeze",
				"unlock",
				"lp",
				"concentration",
				"sybil",
				"wash",
				"drain",
				"sweep",
				"tax",
				"rug"
			],
			"item_pattern": "^[a-z][a-z0-9_]*$",
			"min_pattern_share": 0.6
		},
		"prompt-judgement": {
			"enabled": true,
			"min_chars": 180,
			"min_phrases": 2,
			"phrases": [
				"you are a",
				"you are an",
				"weigh ",
				"weighing",
				"classify as",
				"prefer false positives",
				"be conservative",
				"prioritise",
				"prioritize",
				"rubric",
				"analyst",
				"score the",
				"then classify",
				"judgement",
				"judgment call"
			]
		},
		"packaged-constants": {
			"enabled": true,
			"symbol_hint": "(?i)(weight|score|threshold|signal|factor|rubric|prior|cutoff)",
			"module_segment": "(?i)(scor\\w*|scores?|weights?|risk_scor\\w*|rubric\\w*|signals?|factors?|method\\w*|heuristics?)",
			"constant_pattern": "^[A-Z][A-Z0-9_]*$"
		}
	}
}
