# =============================================================================
# Dockerfile.multistage — Optimized multi-stage build for rmi-backend
# Target: ≤800MB (from 2.98GB)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: builder — install all Python packages with build deps
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc=4:14.2.0-1 \
    libpq-dev=17.10-0+deb13u1 \
    curl=8.14.1-2+deb13u4 \
    git=1:2.47.3-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY requirements.txt .

RUN grep -vE '^flask|^flask-cors|^chromadb' requirements.txt > requirements-prod.txt && \
    pip install --no-cache-dir --prefix=/install -r requirements-prod.txt && \
    pip install --no-cache-dir --prefix=/install slither-analyzer==0.11.5 && \
    rm -rf /install/lib/python3.12/site-packages/torch/test \
           /install/lib/python3.12/site-packages/torch/include \
           /install/lib/python3.12/site-packages/torch/bin

# ---------------------------------------------------------------------------
# Stage 2: runtime — minimal Python image
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5=17.10-0+deb13u1 \
    curl=8.14.1-2+deb13u4 \
    ca-certificates=20250419 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY --from=builder /install /usr/local

RUN curl -sL https://github.com/ethereum/solidity/releases/download/v0.8.26/solc-static-linux -o /usr/local/bin/solc && \
    chmod +x /usr/local/bin/solc

RUN curl -sL https://github.com/foundry-rs/foundry/releases/download/v1.7.1/foundry_v1.7.1_linux_amd64.tar.gz | tar xz -C /usr/local/bin/ cast && \
    chmod +x /usr/local/bin/cast

RUN curl -sL https://github.com/krallin/tini/releases/download/v0.19.0/tini -o /tini && \
    chmod +x /tini

RUN groupadd -r rmi && useradd -r -g rmi -d /app -s /sbin/nologin rmi

WORKDIR /app
COPY --chown=rmi:rmi . .

USER rmi

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/live || exit 1

EXPOSE 8000

ENTRYPOINT ["/tini", "--"]
CMD ["gunicorn", "main:app", "-k", "uvicorn.workers.UvicornWorker", "-w", "4", "--bind", "0.0.0.0:8000", "--timeout", "120", "--keep-alive", "5", "--worker-tmp-dir", "/dev/shm"]

# Security hardening (applied at runtime):
#   --read-only                    Makes rootfs read-only
#   --cap-drop=ALL                 Drops all Linux capabilities
#   --security-opt=no-new-privileges
#   --tmpfs /tmp                   Writable tmpfs for runtime
#   --tmpfs /dev/shm               Writable tmpfs for gunicorn
