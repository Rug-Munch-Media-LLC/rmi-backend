# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.multistage — Optimized multi-stage build for rmi-backend
# Target: ≤800MB (from 2.98GB)
# =============================================================================

# Build args
#   INSTALL_FACE=1  Install ML face-recognition engines (insightface, deepface,
#                   dlib/face_recognition) + pre-bake ArcFace buffalo_l models.
#                   Adds roughly +1GB (see [REVIEW] below). DEFAULT (unset/0)
#                   ships the OSINT CLI tools + OpenCV Haar cascade only, so
#                   /osint /track /face still work with a lean image.
ARG INSTALL_FACE=0

# ---------------------------------------------------------------------------
# Scanner dependency pin — THE build-time override point
# ---------------------------------------------------------------------------
# The authoritative pin lives in pyproject.toml (`rugmunch-scanner @ git+...@<sha>`).
# This ARG exists so an intentional upgrade can be done WITHOUT editing a
# source file, and — more importantly — so a ROLLBACK is a one-flag rebuild.
#
# HOW IT WORKS: the ARG value is substituted into pyproject.toml via an
# environment variable, which PEP 508 direct references cannot interpolate, so
# the substitution is done explicitly with sed before pip reads the file.
# If RUGMUNCH_SCANNER_REF is empty the committed SHA in pyproject.toml is used
# verbatim (the default — see docs/DEPENDENCY-PINNING.md).
#
#   UPGRADE:  --build-arg RUGMUNCH_SCANNER_REF=<40-hex-sha>
#   ROLLBACK: --build-arg RUGMUNCH_SCANNER_REF=<previous-good-sha>
#
# Why an ARG and not a tag: a tag is a mutable pointer and a branch moves on
# every merge. Either one means a rebuilt image can silently install
# unreviewed scanner code, which leaves no rollback target. See pyproject.toml.
ARG RUGMUNCH_SCANNER_REF=""

# ---------------------------------------------------------------------------
# Stage 1: builder — install all Python packages with build deps
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- Deterministic PyPI access (2026-10-24) ---------------------------
# ROOT CAUSE of the failed free-chat image builds: a container on docker's
# default bridge cannot complete a TLS read to pypi.org from this host
# (measured 3/3 ReadTimeoutError after 90s), while the HOST network resolves
# and downloads the same wheel in ~2s. Two independent fixes, both required:
#   1. build on the host network -- `build.network: host` in the compose file
#      and `--network host` in fleet-infra/scripts/deploy/deploy-backend.sh;
#   2. an explicit pip timeout/retry budget for a slow or lossy mirror,
#      applied through the PIP_* ENV in both stages below.
# Do not "fix" a red build by pointing at a third-party index: the index is
# not the failing hop, and an unpinned mirror is a supply-chain change.
WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY requirements.txt .
# The unified deps file is `-e .` (pyproject.toml is the source of truth), so
# the build stage needs the project metadata + package source to resolve it.
COPY pyproject.toml DESIGN.md LICENSE ./
COPY app/ app/

# Honor the build-time scanner pin override (no-op when unset, so the default
# build uses the SHA committed in pyproject.toml — see pyproject.toml:16 and
# docs/DEPENDENCY-PINNING.md). The REF is validated as a 40-hex commit SHA and
# the substitution is anchored on the literal `rugmunch-scanner.git@` prefix, so
# a bad or hostile --build-arg value fails the build loudly instead of
# rewriting the URL or silently installing from a branch.
RUN if [ -n "${RUGMUNCH_SCANNER_REF}" ]; then \
        echo "${RUGMUNCH_SCANNER_REF}" | grep -qE '^[0-9a-f]{40}$' \
          || { echo "ERROR: RUGMUNCH_SCANNER_REF must be a 40-hex commit SHA (got: ${RUGMUNCH_SCANNER_REF})" >&2; exit 1; }; \
        sed -i -E "s#(rugmunch-scanner\.git)@[0-9a-f]{40}#\1@${RUGMUNCH_SCANNER_REF}#" pyproject.toml && \
        grep -n 'rugmunch-scanner @' pyproject.toml; \
    else \
        echo "RUGMUNCH_SCANNER_REF unset — using SHA committed in pyproject.toml"; \
    fi

# Private git+https deps (rugmunch-scanner) authenticate via a BuildKit secret
# mounted as /root/.netrc (forgejo token). The secret is never baked into the
# image layer — it exists only for the duration of this RUN.
RUN --mount=type=secret,id=forgejo_netrc,target=/root/.netrc,mode=0600 \
    grep -vE '^flask|^flask-cors|^chromadb' requirements.txt > requirements-prod.txt && \
    pip install --no-cache-dir --prefix=/install -r requirements-prod.txt && \
    pip install --no-cache-dir --prefix=/install slither-analyzer==0.11.5 && \
    rm -rf /install/lib/python3.12/site-packages/torch/test \
           /install/lib/python3.12/site-packages/torch/include \
           /install/lib/python3.12/site-packages/torch/bin

# OpenTelemetry auto-instrumentation (pyproject [otel] extra). Installed
# explicitly: re-resolving `-e .[otel]` here would need the Forgejo netrc secret.
RUN pip install --no-cache-dir --prefix=/install \
    opentelemetry-instrumentation-fastapi==0.65b0 \
    opentelemetry-instrumentation-sqlalchemy==0.65b0 \
    opentelemetry-instrumentation-httpx==0.65b0 \
    opentelemetry-instrumentation-redis==0.65b0 \
    opentelemetry-instrumentation-logging==0.65b0 \
    opentelemetry-instrumentation-aiohttp-client==0.65b0

# ---------------------------------------------------------------------------
# Stage 2: runtime — minimal Python image
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    whois \
    libglib2.0-0t64 \
    libxcb1 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY --from=builder /install /usr/local

# ─── OSINT toolchain (default: CLI tools + Haar cascade) ───────────────
# Deployed instances must run every app/osint/* module at full capability:
#   username → sherlock CLI (sherlock-project) + maigret fallback
#   email    → holehe CLI (+ HIBP/emailrep via HTTP)
#   domain   → whois CLI fallback (python-whois already in requirements)
#   face     → OpenCV Haar cascade via opencv-python-headless (see below)
# The CLIs are invoked via subprocess (never imported), so pip installs into
# the runtime image's /usr/local are sufficient.
#
# opencv-python-headless also ships the cascade at cv2.data.haarcascades
# (the path app/domains/telegram/rugmunchbot/handlers/osint.py reads); we
# additionally mirror haarcascade_frontalface_default.xml to
# /usr/share/opencv4/haarcascades as a stable, toolchain-independent path.
RUN pip install --no-cache-dir \
        sherlock-project==0.16.0 \
        maigret==0.6.4 \
        holehe==1.61 \
        opencv-python-headless==4.13.0.90 \
    && mkdir -p /usr/share/opencv4/haarcascades \
    && curl -fsSL \
        https://raw.githubusercontent.com/opencv/opencv/4.13.0/data/haarcascades/haarcascade_frontalface_default.xml \
        -o /usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml \
    && rm -rf /root/.cache/pip

# [REVIEW] Heavy face-recognition engines (opt-in via INSTALL_FACE=1):
#   insightface + onnxruntime + opencv ≈ +500MB; dlib (build via cmake/g++,
#   consumed by face_recognition) adds ~+200MB; pre-baked ArcFace buffalo_l
#   models add ~+330MB and require network at build time. Default image
#   intentionally excludes these: /face still works via the Haar cascade and
#   app/osint/face.py degrades gracefully (OsintNotAvailable) when no ML
#   engine is present. Enable only on face-heavy deployments.
ENV INSIGHTFACE_HOME=/opt/insightface
RUN if [ "${INSTALL_FACE:-0}" = "1" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            cmake=3.31.6-2 \
            g++=4:14.2.0-1 \
            && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
        && pip install --no-cache-dir \
            insightface==1.0.1 \
            onnxruntime==1.28.0 \
            deepface==0.0.100 \
            dlib==20.0.1 \
            face-recognition==1.3.0 \
        && rm -rf /root/.cache/pip \
        && mkdir -p /opt/insightface; \
        # Pre-bake ArcFace buffalo_l so first inference is offline. Scoped to
        # its own statement (NOT part of the && chain above) so a build-time
        # model-download failure cannot mask install failures; non-fatal here
        # because runtime auto-download works with a writable $INSIGHTFACE_HOME
        # (mount a volume at /opt/insightface).
        python -c "from insightface.app import FaceAnalysis; FaceAnalysis(name='buffalo_l', root='/opt/insightface', providers=['CPUExecutionProvider'])" \
            || echo "WARN: buffalo_l pre-bake failed — will auto-download at first use (needs writable \$INSIGHTFACE_HOME)"; \
    fi

RUN curl -sL https://github.com/ethereum/solidity/releases/download/v0.8.26/solc-static-linux -o /usr/local/bin/solc && \
    chmod +x /usr/local/bin/solc

RUN curl -sL https://github.com/foundry-rs/foundry/releases/download/v1.7.1/foundry_v1.7.1_linux_amd64.tar.gz | tar xz -C /usr/local/bin/ cast && \
    chmod +x /usr/local/bin/cast

RUN curl -sL https://github.com/krallin/tini/releases/download/v0.19.0/tini -o /tini && \
    chmod +x /tini

RUN groupadd -r rmi && useradd -r -g rmi -d /app -s /sbin/nologin rmi

WORKDIR /app
COPY --chown=rmi:rmi . .

# hadolint ignore=DL3066
USER rmi

# hadolint ignore=DL3025
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/live || exit 1

EXPOSE 8000

ENTRYPOINT ["/tini", "--"]
CMD ["gunicorn", "main:app", "-k", "uvicorn.workers.UvicornWorker", "-w", "4", "--bind", "0.0.0.0:8000", "--timeout", "120", "--keep-alive", "5", "--worker-tmp-dir", "/dev/shm"]

# Security hardening (applied at runtime):
#   --read-only                    Makes rootfs read-only
#   --cap-drop=ALL                 Drops all Linux capabilities
#   --security-opt=no-new-privileges
#   --tmpfs /tmp                   Writable tmpfs for runtime
#   --tmpfs /dev/shm               Writable tmpfs for gunicorn
