# Mempool Dumpster — environment template
# Copy to `.env` and fill in real values. Secrets (RPC keys, ClickHouse
# password, feed auths) come from the secrets manager / env vars — NEVER
# commit a real .env; this file is the committed placeholder template only.
#
#   cp .env.example .env
#   # fill in values, then:
#   docker compose up -d
#
# Minimal working setup for a geth node on localhost (ws://127.0.0.1:8546)
# sinking into the existing rmi-clickhouse:

# --- Mempool sources ----------------------------------------------------------
# Comma-separated ws/wss EL node endpoints. At least one required.
# Examples:
#   geth / Erigon / Infura : ws://127.0.0.1:8546
#   Alchemy                : wss://eth-mainnet.g.alchemy.com/v2/<KEY>
#   Alchemy pending txs    : wss://eth-mainnet.g.alchemy.com/v2/<KEY> (uses
#                            alchemy_pendingTransactions — burns credits fast)
NODES=ws://127.0.0.1:8546

# Node used to check whether seen transactions were already included on-chain.
# Leave empty to skip the inclusion check.
CHECK_NODE=

# Comma-separated alias=url mappings that label sources (optional).
# Example: SRC_ALIASES=local=ws://127.0.0.1:8546,alchemy=wss://eth-mainnet.g.alchemy.com/v2/KEY
SRC_ALIASES=

# Premium feed auths (optional). Format: "token" or "token@url".
BLX_AUTH=
CHAINBOUND_AUTH=
EDEN_AUTH=

# --- Output -------------------------------------------------------------------
# Local archive dir inside the container (mounted volume). CSVs are written
# here even when the ClickHouse sink is enabled (durable fallback).
OUT=/mnt/data

# Free-form location tag recorded in sourcelogs rows.
LOCATION=[INTERNAL_HOST]-eu

# --- ClickHouse sink ------------------------------------------------------------
# Format: clickhouse://user:password@host:9000/database
# Production: attach to the existing rmi-clickhouse service on rmi_network.
#   user/db/password match the values from the root docker-compose.yml
#   (CLICKHOUSE_USER/CLICKHOUSE_DB/CLICKHOUSE_PASSWORD, default user `rmi`,
#   db `rmi`). Recommended: create a dedicated `mempool` database + user.
# Standalone (compose --profile standalone): use
#   clickhouse://mempool:<PASSWORD>@mempool-dumpster-clickhouse:9000/mempool
CLICKHOUSE_DSN=

# Rows per batch written to ClickHouse.
CLICKHOUSE_BATCH_SIZE=300

# --- Image pin (optional override) ----------------------------------------------
# MEMPOOL_DUMPSTER_IMAGE=flashbots/mempool-dumpster:1.3.1

# --- Standalone ClickHouse (compose --profile standalone only) -------------------
# User/password for the isolated test ClickHouse instance.
CLICKHOUSE_USER=mempool
CLICKHOUSE_PASSWORD=mempool-password-change-me

# --- Uptime monitoring (optional) -------------------------------------------------
# https://healthchecks.io ping URL; collector pings it on success cycles.
HEALTHCHECKS_IO_URI=
