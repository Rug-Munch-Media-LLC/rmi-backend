# ─── TrueBlocks local address-index configuration ────────────────────────
# Copy to .env and edit BEFORE first run:
#     cp .env.example .env
#
# All values documented against trueblocks/core:v5.0.0.
# Secrets: leave TB_KEYS_ETHERSCAN_APIKEY empty unless you have a key —
# never commit a real key; source it from gopass/secrets manager.

# ─── Chain ────────────────────────────────────────────────────────────────
# Chain TrueBlocks operates on. MUST match the per-chain RPC variable
# below (TrueBlocks convention: TB_CHAINS_<CHAIN>_RPCPROVIDER).
# If you change this, rename the RPC variable to match, e.g. sepolia:
#     TB_SETTINGS_DEFAULTCHAIN=sepolia
#     TB_CHAINS_SEPOLIA_RPCPROVIDER=http://127.0.0.1:8545
TB_SETTINGS_DEFAULTCHAIN=mainnet

# ─── Archive/tracing node RPC (REQUIRED) ─────────────────────────────────
# The daemon refuses to start without a reachable RPC. For the initial
# `chifra scrape` index build this must be an ARCHIVE + TRACING node
# (e.g. Erigon/geth --syncmode archive --gcmode archive with tracing
# enabled). Shared/rate-limited RPCs (Infura etc.) will be hammered and
# rate-limit — prefer a local/internal archive node.
# NOTE: use the chain-specific variable name; for mainnet it is
# TB_CHAINS_MAINNET_RPCPROVIDER.
TB_CHAINS_MAINNET_RPCPROVIDER=http://127.0.0.1:8545

# ─── Optional: Etherscan API key ─────────────────────────────────────────
# Enables articulation (turning raw EVM byte data into human-readable
# names/function signatures). Only used to warm the ABI/name cache.
# Empty = disabled. Never commit a real key.
TB_KEYS_ETHERSCAN_APIKEY=

# ─── Host port ────────────────────────────────────────────────────────────
# Host port for the TrueBlocks API server (container port is fixed at
# 8080). Bound to loopback by default in docker-compose.yml.
TB_SERVE_PORT=8080
