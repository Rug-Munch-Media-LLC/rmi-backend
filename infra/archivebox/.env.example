# ─── ArchiveBox evidence-capture configuration ────────────────────────────
# Copy to .env and edit BEFORE first run:
#     cp .env.example .env
# Generate secrets (never commit real values):
#     openssl rand -hex 32          # for SECRET_KEY
#     openssl rand -base64 24       # for ADMIN_PASSWORD (or your secrets manager)
# All values documented against archivebox/archivebox:0.7.4 (v0.7.x line).

# ─── Networking ───────────────────────────────────────────────────────────
# Host port (bound to loopback by default in docker-compose.yml).
ARCHIVEBOX_PORT=8000

# Canonical URL investigators use to reach the UI. Used for absolute links
# and host validation. Set to the real access URL when remote, e.g.
#     BASE_URL=http://archivebox.tail1234.ts.net
BASE_URL=http://127.0.0.1:8000

# Hosts allowed to serve the UI. "*" = any Host header — acceptable while
# the port is loopback-bound; restrict when exposed, e.g.
#     ALLOWED_HOSTS=archivebox.tail1234.ts.net
ALLOWED_HOSTS=*

# ─── Admin (required on first run) ────────────────────────────────────────
# These create the admin superuser the first time the container starts.
# Changing them later has no effect — use `archivebox manage changepassword`
# or the admin UI instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_generate_with_gopass

# Django secret used for sessions/CSRF. REQUIRED, generate a new one:
#     openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl

# ─── Evidence lock-down ───────────────────────────────────────────────────
# Evidence must not be publicly browsable or submittable. Keep these off
# (the UI requires login for everything).
PUBLIC_INDEX=False        # anonymous browsing of the snapshot index
PUBLIC_SNAPSHOTS=False    # anonymous viewing of individual snapshots
PUBLIC_ADD_VIEW=False     # anonymous submission of new URLs

# ─── Capture behavior ─────────────────────────────────────────────────────
# Per-extractor timeout in seconds (default 60). Scam pages are often slow,
# geo-blocked, or rate-limited — keep generous so captures complete.
TIMEOUT=120

# Capture even when the target has a broken/self-signed TLS cert (very
# common on scam/phishing sites). Keep False ONLY for evidence capture.
CHECK_SSL_VALIDITY=False

# ─── SAVE_* extractor toggles (all default True; listed for visibility) ───
SAVE_WARC=True             # Web ARChive (WARC) — canonical web-capture format
SAVE_WGET=True             # wget recursive mirror (raw HTML tree)
SAVE_PDF=True              # PDF render of the page
SAVE_SCREENSHOT=True       # full-page PNG screenshot
SAVE_SINGLEFILE=True       # self-contained HTML (singlefile)
SAVE_DOM=True              # raw DOM HTML
SAVE_READABILITY=True      # readability-cleaned article HTML
SAVE_TITLE=True            # page <title>
SAVE_FAVICON=True          # site favicon
SAVE_HEADERS=True          # HTTP response headers (server, TLS, dates)
SAVE_MEDIA=True            # embedded media files (can be large — see below)
SAVE_GIT=True              # git clone when the target exposes a repo
# Toggle any extractor off by setting it to False, e.g. SAVE_MEDIA=False
# to keep captures lean when only page content matters.

# ─── Media / storage ──────────────────────────────────────────────────────
MEDIA_MAX_SIZE=750m        # per-file media download cap (default 750m)
MEDIA_TIMEOUT=3600         # max media download time, seconds (default 3600)

# ─── Process user (optional) ──────────────────────────────────────────────
# UID/GID the archive files are written as on the host (defaults to the
# container user). Set to your host user for easy browsing/backup:
PUID=1000
PGID=1000
