# Postiz environment — copy to .env and fill in secrets.
#   cp .env.example .env
# Reference: https://docs.postiz.com/configuration/reference
#
# NEVER commit the real .env (root .gitignore covers it). Generate secrets
# with e.g. `openssl rand -hex 32` and store them in the secrets manager
# (gopass / env vars on the host), not in git.

# ── Required ────────────────────────────────────────────────────────────
# The public URL users/browsers hit Postiz at. Loopback for local-only use.
# If exposed via Cloudflare Tunnel, set this to the tunnel hostname
# (e.g. https://postiz.example.com) BEFORE first login — changing it later
# invalidates saved OAuth callback URLs.
MAIN_URL=http://127.0.0.1:4007
FRONTEND_URL=http://127.0.0.1:4007
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4007/api
BACKEND_INTERNAL_URL=http://localhost:3000

# Random long string, unique per install. `openssl rand -hex 32`
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Compose wiring (service names, not loopback — overridden in the compose
# file, kept here only for reference / standalone runs). The password here
# MUST match POSTGRES_PASSWORD below when running outside compose.
DATABASE_URL=postgresql://postiz-user:change-me-postgres-password@postiz-postgres:5432/postiz-db
REDIS_URL=redis://postiz-redis:6379

# ── Database credentials (consumed by the postgres service) ─────────────
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=postiz-db

# ── App behaviour ───────────────────────────────────────────────────────
# Single-operator install: register the first user, then lock registration.
DISABLE_REGISTRATION=false
# API hourly rate limit for the public API.
API_LIMIT=30

# ── Storage (local is default; no Cloudflare R2 needed) ─────────────────
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ── X / Twitter (OAuth 1.0a — create app at developer.twitter.com) ──────
# @cryptorugmunch's own app credentials. Empty = channel not offered.
X_API_KEY=
X_API_SECRET=

# ── Telegram (BotFather bot — cross-posts to @cryptorugmuncher) ─────────
# 1. /newbot in BotFather -> get TELEGRAM_TOKEN
# 2. Add the bot as ADMIN to the target channel (@cryptorugmuncher)
# 3. Set TELEGRAM_BOT_NAME to the bot handle (without @)
# NOTE: one bot token can only run ONE connected process at a time — do not
# reuse the @rugmunchbot token; create a dedicated posting bot.
TELEGRAM_BOT_NAME=
TELEGRAM_TOKEN=

# ── Optional platforms (blank = disabled) ───────────────────────────────
# LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Bluesky — no app id/secret; connect via handle+app password in the UI.
# Mastodon — self-hosted instance + client app.
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# ── [REVIEW] Temporal scheduler stack ───────────────────────────────────
# Postiz >= v2.12.0 uses Temporal for scheduled publishing. The minimal
# deployment here runs without it. If scheduled posts don't fire, deploy the
# Temporal stack (see README) and uncomment:
# TEMPORAL_ADDRESS=temporal:7233
# RUN_CRON=true
