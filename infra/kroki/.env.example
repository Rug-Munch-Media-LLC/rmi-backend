# Kroki diagram server — environment template
#
# Usage:  cp infra/kroki/.env.example infra/kroki/.env
# All values have sane defaults; the file is optional unless you need to
# override image pins, the host port, or limits.
#
# Security: Kroki needs NO credentials (loopback-only, local rendering).
# Never commit a real .env — it is gitignored; only this template is committed.

# --- Image pins (audit upstream tags before bumping) ------------------------
KROKI_IMAGE=yuzutech/kroki:0.32.1
KROKI_MERMAID_IMAGE=yuzutech/kroki-mermaid:0.32.1

# --- Listen (host side) ------------------------------------------------------
# Host port bound to 127.0.0.1 only. The container always listens on 8000.
# 8010 default: 8000 is the rmi-backend API port and 8005 is `pry` on this
# fleet — both already bound to loopback.
KROKI_LISTEN_PORT=8010

# --- Security ----------------------------------------------------------------
# SECURE (default) = strictest profile: PlantUML sandbox, no external
# !include. SAFE/UNSAFE are weaker — only for trusted-local experimentation.
KROKI_SAFE_MODE=SECURE

# --- Limits ------------------------------------------------------------------
# Max length of an encoded diagram URL (default 4096; docs recommend <= 8192).
KROKI_MAX_URI_LENGTH=8192
# Max POST body size (applies to mermaid/excalidraw/bpmn companions).
KROKI_MAX_BODY_SIZE=1mb
# Per-render timeouts.
KROKI_COMMAND_TIMEOUT=5s
KROKI_CONVERT_TIMEOUT=20s
KROKI_DELEGATE_TIMEOUT_MS=30000

# --- Mermaid companion -------------------------------------------------------
# Max source chars for one Mermaid diagram (beyond => HTTP 400).
KROKI_MERMAID_MAX_TEXT_SIZE=50000
# Concurrent Mermaid renders (beyond => queued).
KROKI_MERMAID_MAX_CONCURRENCY=6
