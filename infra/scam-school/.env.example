# Scam School — CourseLit LMS + H5P/Lumi interactive lessons
# ===========================================================
# Environment template. Copy to .env and edit BEFORE first run:
#     cp .env.example .env
#
# Secrets: NEVER commit .env (it is gitignored). Generate AUTH_SECRET with:
#     openssl rand -base64 48
#
# Image pins (audited 2026-08-15 against Docker Hub):
#   codelit/courselit-app:0.74.4   (AGPL-3.0; == :latest digest)
#   mongo:7.0                      (MongoDB 7.0, current 7.0.40)
#   nginx:1.30.4-alpine            (H5P static lesson host)

# --- CourseLit (LMS) --------------------------------------------------------
# REQUIRED — signs auth tokens / magic-link JWTs. Set to a long random string,
# e.g. the output of `openssl rand -base64 48`. Never reuse a value committed
# anywhere.
AUTH_SECRET=REPLACE_WITH_RANDOM_64_CHARS

# REQUIRED — email that becomes the platform super admin on first boot.
# Login uses magic links, so keep the mailbox reachable, or watch the
# container logs for the one-time link:  docker compose logs -f courselit
SUPER_ADMIN_EMAIL=admin@rugmunch.io

# MongoDB connection string. `mongo` resolves via the compose network. The
# password here MUST match MONGO_INITDB_ROOT_PASSWORD below (authSource=admin).
DB_CONNECTION_STRING=mongodb://scamschool:REPLACE_WITH_STRONG_DB_PASSWORD@mongo:27017/courselit?authSource=admin
# Standalone Mongo in compose: transactions disabled (upstream default).
DB_TRANSACTIONS=false

# Optional SMTP — required for real magic-link delivery. If left blank, mails
# are dumped to the container console (fine for local/eval).
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# --- MongoDB ----------------------------------------------------------------
# First-boot root user for the mongo container. MUST match the credentials in
# DB_CONNECTION_STRING above.
MONGO_INITDB_ROOT_USERNAME=scamschool
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# --- Host ports (loopback-only binds) ---------------------------------------
# CourseLit LMS web UI (container listens on :80).
COURSELIT_PORT=8090
# H5P static lesson host (Lumi-exported standalone HTML).
H5P_PORT=8091

# --- Image pins (audit upstream tags before bumping) -------------------------
COURSELIT_IMAGE=codelit/courselit-app:0.74.4
MONGO_IMAGE=mongo:7.0
H5P_IMAGE=nginx:1.30.4-alpine
