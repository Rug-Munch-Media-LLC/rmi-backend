# CompreFace 1.2.0 — self-hosted face recognition (4th face engine)
# =================================================================
# Copy to .env, adjust, then: docker compose up -d --wait
# All host ports are loopback-only (127.0.0.1) — never expose publicly.

# Image tag — current stable release (see https://github.com/exadel-inc/CompreFace/releases)
COMPREFACE_VERSION=1.2.0

# Loopback host ports
COMPREFACE_API_PORT=8000     # recognition/detection API  -> COMPREFACE_URL=http://127.0.0.1:8000
COMPREFACE_ADMIN_PORT=8001   # admin management API (create apps + face services / API keys)

# Backing Postgres — internal to the compose network (used by api + admin)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=frs

# JVM heap for the Java services
COMPREFACE_API_JAVA_OPTS=-Xmx4g
COMPREFACE_ADMIN_JAVA_OPTS=-Xmx1g

# ML core workers
COMPREFACE_UWSGI_PROCESSES=2
COMPREFACE_UWSGI_THREADS=1

# Maximum image size the API accepts (suffix must match Java: 5MB / 10M)
COMPREFACE_MAX_FILE_SIZE=5MB
COMPREFACE_MAX_REQUEST_SIZE=10M
