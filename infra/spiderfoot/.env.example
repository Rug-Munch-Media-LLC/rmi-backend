# SpiderFoot configuration — copy to .env and edit.
# No secrets are required to run SpiderFoot itself; the API is only exposed
# on 127.0.0.1 (loopback). If you enable SpiderFoot's optional passwd-file
# authentication, keep that file OUT of git.

# Version tag of the upstream SpiderFoot source to build (git tag).
SPIDERFOOT_VERSION=v4.0.0

# Host port the web UI / JSON API is published on (loopback only).
SPIDERFOOT_PORT=5001
