[Unit]
Description=RMI Admin Bot — Fleet ChatOps (Secure Launcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/srv/work/repos/rmi-backend
ExecStart=/srv/work/repos/rmi-backend/.venv/bin/python -m app.domains.telegram.secure_launcher adminbot
Restart=on-failure
RestartSec=5
# --- SECURITY HARDENING ---
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/work/repos/rmi-backend
ReadOnlyPaths=/srv/work/repos/rmi-backend
ProtectProc=invisible
# --- END SECURITY ---

[Install]
WantedBy=multi-user.target
