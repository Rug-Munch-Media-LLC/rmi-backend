[Unit]
Description=RMI Admin Bot — Fleet ChatOps (Secure Launcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/work/repos/rmi-backend
ExecStart=/srv/work/repos/rmi-backend/.venv/bin/python -m app.domains.telegram.secure_launcher adminbot
Restart=on-failure
RestartSec=5
Environment=HOME=/root
Environment=ADMIN_CHAT_ID=7075336557
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/srv/work/repos/rmi-backend /root/.local/share/gopass /root/.gnupg
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
