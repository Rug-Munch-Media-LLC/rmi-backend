[Unit]
Description=RugMunchBot — Telegram Bot (Secure Launcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/srv/work/repos/rmi-backend
ExecStart=/srv/work/repos/rmi-backend/.venv/bin/python -m app.domains.telegram.secure_launcher rugmunchbot
Restart=on-failure
RestartSec=5
# --- SECURITY HARDENING ---
# Token lives EXCLUSIVELY in gopass. No Environment= or EnvironmentFile=.
# The secure_launcher reads from gopass, sets env transiently, unsets before polling.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/work/repos/rmi-backend/app/domains/telegram/rugmunchbot/data
ReadOnlyPaths=/srv/work/repos/rmi-backend
# Prevent token leakage via /proc
ProtectProc=invisible
# --- END SECURITY ---

[Install]
WantedBy=multi-user.target
