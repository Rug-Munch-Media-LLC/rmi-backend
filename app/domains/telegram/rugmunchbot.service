[Unit]
Description=RugMunchBot — Telegram Bot (Secure Launcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/work/repos/rmi-backend
ExecStart=/srv/work/repos/rmi-backend/.venv/bin/python -m app.domains.telegram.secure_launcher rugmunchbot
Restart=on-failure
RestartSec=5
Environment=HOME=/root
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/srv/work/repos/rmi-backend /root/.local/share/gopass /root/.gnupg
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
