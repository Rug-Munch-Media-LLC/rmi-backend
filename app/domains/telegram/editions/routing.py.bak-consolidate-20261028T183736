"""Tiered routing — consume a Lane C decision and turn it into send jobs.

The input is one routing decision per story, in the shape Lane C emits::

    {"slug": "...", "title": "...", "teaser": "...", "url": "...",
     "image_url": "...", "tags": ["..."],
     "lanes": ["main", "news"], "big_story": true, "score": 0.82}

Keys are read defensively (``lanes``/``route``/``decision``/``channels``,
``big_story``/``promote``/``high_importance``) because Lane C owns the shape
and this module must not force a rewrite of it. What this module *does* own:

* **promotion** — a ``big_story`` is always delivered to ``alerts`` *and*
  ``main``, whatever else the decision says;
* **caps** — ``RMI_TG_LANE_DAILY_CAP_<LANE>`` per UTC day, absent lanes fall
  back to ``DEFAULT_CAPS``, ``0``/negative means uncapped;
* **dedupe** — ``(day, lane, slug)`` via the ledger, so a story never repeats
  in a lane on the same day even when two plans run.

``site`` is addressable but has no Telegram surface, so it is skipped with a
reason instead of silently disappearing.
"""

from __future__ import annotations

import os
from dataclasses import dataclass, field
from typing import TYPE_CHECKING, Any

from app.domains.telegram.editions.ledger import DeliveryLedger, dedupe_key
from app.domains.telegram.editions.lanes import LANES

if TYPE_CHECKING:
    from collections.abc import Mapping, Sequence

DEFAULT_CAPS: dict[str, int] = {
    "main": 6,
    "alerts": 25,
    "news": 40,
    "alpha": 30,
    "whales": 20,
    "site": 0,
}

PROMOTION_LANES: tuple[str, ...] = ("alerts", "main")
_LANE_ALIASES: dict[str, str] = {
    "main_channel": "main",
    "mainchannel": "main",
    "news_channel": "news",
    "alerts_channel": "alerts",
    "telegram": "main",
    "web": "site",
    "blog": "site",
}


@dataclass(frozen=True, slots=True)
class RouteDecision:
    """One story plus the lanes Lane C decided it belongs in."""

    slug: str
    title: str
    teaser: str = ""
    url: str = ""
    image_url: str | None = None
    tags: tuple[str, ...] = ()
    lanes: tuple[str, ...] = ("main",)
    big_story: bool = False
    score: float = 0.0
    raw: Mapping[str, Any] = field(default_factory=dict, compare=False)

    def as_dict(self) -> dict[str, Any]:
        return {
            "slug": self.slug,
            "title": self.title,
            "teaser": self.teaser,
            "url": self.url,
            "image_url": self.image_url,
            "tags": list(self.tags),
            "lanes": list(self.lanes),
            "big_story": self.big_story,
            "score": self.score,
        }


@dataclass(frozen=True, slots=True)
class PlannedPost:
    """One story going to one lane."""

    decision: RouteDecision
    lane: str
    key: str


@dataclass(frozen=True, slots=True)
class Skipped:
    slug: str
    lane: str | None
    reason: str


@dataclass(frozen=True, slots=True)
class DeliveryPlan:
    posts: tuple[PlannedPost, ...] = ()
    skipped: tuple[Skipped, ...] = ()

    def for_lane(self, lane: str) -> tuple[PlannedPost, ...]:
        return tuple(post for post in self.posts if post.lane == lane)

    @property
    def lanes(self) -> tuple[str, ...]:
        return tuple(lane for lane in LANES if self.for_lane(lane))


def _first(raw: Mapping[str, Any], *keys: str, default: Any = None) -> Any:
    for key in keys:
        value = raw.get(key)
        if value not in (None, "", (), []):
            return value
    return default


def _normalise_lane(value: object) -> str | None:
    lane = str(value).strip().lower()
    lane = _LANE_ALIASES.get(lane, lane)
    return lane if lane in LANES else None


def _lane_list(raw: Mapping[str, Any]) -> tuple[str, ...]:
    declared = _first(raw, "lanes", "route", "decision", "channels", "targets", "publish_to")
    if isinstance(declared, str):
        declared = declared.replace("|", ",").split(",")
    if not declared:
        return ("main",)
    return tuple(lane for lane in (_normalise_lane(item) for item in declared) if lane)


def _is_big_story(raw: Mapping[str, Any]) -> bool:
    flag = _first(raw, "big_story", "promote", "high_importance", "is_big_story", default=False)
    if isinstance(flag, str):
        return flag.strip().lower() in {"1", "true", "yes", "on"}
    return bool(flag)


def _score(raw: Mapping[str, Any]) -> float:
    try:
        return float(_first(raw, "score", "priority", "importance", default=0.0))
    except (TypeError, ValueError):
        return 0.0


def _tags(raw: Mapping[str, Any]) -> tuple[str, ...]:
    tags = _first(raw, "tags", "keywords", default=())
    if isinstance(tags, str):
        tags = tags.replace("|", ",").split(",")
    return tuple(str(tag) for tag in tags)


def parse_decision(raw: Mapping[str, Any]) -> RouteDecision:
    """Read one Lane C decision defensively; raises ``ValueError`` if unusable."""
    slug = str(_first(raw, "slug", "story_slug", "id", default="") or "").strip()
    title = str(_first(raw, "title", "headline", default="") or "").strip()
    if not slug and not title:
        raise ValueError("decision has neither slug nor title")
    lanes = _lane_list(raw)
    if _is_big_story(raw):
        lanes = tuple(dict.fromkeys((*lanes, *PROMOTION_LANES)))
    return RouteDecision(
        slug=slug,
        title=title,
        teaser=str(_first(raw, "teaser", "dek", "summary", "description", default="") or ""),
        url=str(_first(raw, "url", "canonical_url", "link", default="") or ""),
        image_url=_first(raw, "image_url", "image", "og_image"),
        tags=_tags(raw),
        lanes=lanes,
        big_story=_is_big_story(raw),
        score=_score(raw),
        raw=raw,
    )


def lane_cap(lane: str, env: Mapping[str, str] | None = None) -> int:
    """Per-UTC-day cap for *lane*: env override, else ``DEFAULT_CAPS``, else 0."""
    source = os.environ if env is None else env
    key = f"RMI_TG_LANE_DAILY_CAP_{lane.upper()}"
    raw = source.get(key)
    if raw is not None and str(raw).strip():
        try:
            return int(str(raw).strip())
        except ValueError:
            return DEFAULT_CAPS.get(lane, 0)
    return DEFAULT_CAPS.get(lane, 0)


def plan_delivery(
    decisions: Sequence[Mapping[str, Any] | RouteDecision],
    *,
    day: str,
    ledger: DeliveryLedger,
    env: Mapping[str, str] | None = None,
) -> DeliveryPlan:
    """Turn Lane C decisions into an ordered, capped, deduped send plan."""
    posts: list[PlannedPost] = []
    skipped: list[Skipped] = []
    admitted: dict[str, int] = {}

    for raw in decisions:
        try:
            decision = raw if isinstance(raw, RouteDecision) else parse_decision(raw)
        except ValueError as exc:
            skipped.append(Skipped(slug=str(raw.get("slug", "?")), lane=None, reason=f"unparseable:{exc}"))
            continue

        for lane in LANES:
            if lane not in decision.lanes:
                continue
            if lane == "site":
                skipped.append(Skipped(decision.slug, lane, "no_telegram_surface"))
                continue
            key = dedupe_key(day, lane, decision.slug, decision.url or decision.title)
            if ledger.already_sent(key):
                skipped.append(Skipped(decision.slug, lane, "duplicate"))
                continue
            cap = lane_cap(lane, env)
            used = ledger.lane_count(day, lane) + admitted.get(lane, 0)
            if cap > 0 and used >= cap:
                skipped.append(Skipped(decision.slug, lane, "cap_reached"))
                continue
            admitted[lane] = admitted.get(lane, 0) + 1
            posts.append(PlannedPost(decision=decision, lane=lane, key=key))

    return DeliveryPlan(posts=tuple(posts), skipped=tuple(skipped))


__all__ = [
    "DEFAULT_CAPS",
    "PROMOTION_LANES",
    "DeliveryPlan",
    "PlannedPost",
    "RouteDecision",
    "Skipped",
    "lane_cap",
    "parse_decision",
    "plan_delivery",
]
