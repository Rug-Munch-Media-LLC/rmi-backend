"""The three daily editions — 06:30 / 12:30 / 21:30 UTC.

Lane E owns *delivery*, not content: each edition takes Lane B's lead story
(``slug``/``teaser``/``url``/``image_url``/``tags``) and renders exactly one
post — title, one teaser paragraph, canonical site link, image, tags.

Titles come from Lane B and are env-overridable per edition
(``RMI_TG_EDITION_TITLE_<KEY>``) so a copy change never needs a deploy. The
defaults below are the titles this lane was handed; they are the only strings
in this module that are not configuration.

Delivery target defaults to ``main`` and is overridable with
``RMI_TG_EDITION_LANES`` (comma-separated), which is how the same code serves
a second channel without a branch.
"""

from __future__ import annotations

import os
from dataclasses import dataclass
from datetime import UTC, datetime, time, timedelta
from typing import TYPE_CHECKING, Any

from app.domains.telegram.editions.delivery import DeliveryReport, deliver
from app.domains.telegram.editions.retry import DeliveryConfig
from app.domains.telegram.editions.sender import Sender
from app.domains.telegram.editions.ledger import DeliveryLedger, day_key
from app.domains.telegram.editions.payloads import TelegramPayload
from app.domains.telegram.editions.render import edition_payload
from app.domains.telegram.editions.routing import PlannedPost, plan_delivery

if TYPE_CHECKING:
    from collections.abc import Awaitable, Callable, Mapping

SITE_URL_ENV = "RMI_SITE_URL"
DEFAULT_SITE_URL = "https://rugmunch.io"
EDITION_LANES_ENV = "RMI_TG_EDITION_LANES"


@dataclass(frozen=True, slots=True)
class Edition:
    """One scheduled edition: a slug-safe key, a title and a UTC time."""

    key: str
    title: str
    hour: int
    minute: int
    emoji: str

    @property
    def env_title_var(self) -> str:
        return f"RMI_TG_EDITION_TITLE_{self.key.upper()}"

    @property
    def runs_at(self) -> time:
        return time(hour=self.hour, minute=self.minute, tzinfo=UTC)

    @property
    def slug(self) -> str:
        return f"edition-{self.key}"


EDITIONS: tuple[Edition, ...] = (
    Edition(key="morning", title="Morning Rug", hour=6, minute=30, emoji="☀️"),
    Edition(key="midday", title="Midday", hour=12, minute=30, emoji="🌤️"),
    Edition(key="evening", title="Evening", hour=21, minute=30, emoji="🌙"),
)


def get_edition(key: str) -> Edition:
    """Look up one edition by key; ``KeyError`` lists the valid keys."""
    for edition in EDITIONS:
        if edition.key == key.strip().lower():
            return edition
    valid = ", ".join(item.key for item in EDITIONS)
    raise KeyError(f"unknown edition {key!r} (valid: {valid})")


def edition_title(edition: Edition, env: Mapping[str, str] | None = None) -> str:
    source = os.environ if env is None else env
    return (source.get(edition.env_title_var) or edition.title).strip()


def site_url(env: Mapping[str, str] | None = None) -> str:
    source = os.environ if env is None else env
    return (source.get(SITE_URL_ENV) or DEFAULT_SITE_URL).rstrip("/")


def edition_lanes(env: Mapping[str, str] | None = None) -> tuple[str, ...]:
    source = os.environ if env is None else env
    raw = source.get(EDITION_LANES_ENV) or "main"
    return tuple(part.strip().lower() for part in raw.replace("|", ",").split(",") if part.strip())


def next_run(edition: Edition, now: datetime | None = None) -> datetime:
    """The next UTC instant this edition fires (today if still ahead)."""
    moment = (now or datetime.now(UTC)).astimezone(UTC)
    candidate = moment.replace(hour=edition.hour, minute=edition.minute, second=0, microsecond=0)
    return candidate if candidate > moment else candidate + timedelta(days=1)


def schedule(now: datetime | None = None) -> tuple[dict[str, Any], ...]:
    """Value-free schedule table (for docs, health checks and the dry run)."""
    return tuple(
        {
            "key": edition.key,
            "title": edition_title(edition),
            "at_utc": f"{edition.hour:02d}:{edition.minute:02d}",
            "next_run": next_run(edition, now).isoformat(),
        }
        for edition in EDITIONS
    )


def render_edition(
    edition: Edition,
    lead: Mapping[str, Any],
    *,
    env: Mapping[str, str] | None = None,
    date: str | None = None,
) -> TelegramPayload:
    """Pure render — the exact payload that will be sent, with no side effect."""
    return edition_payload(
        title=edition_title(edition, env),
        emoji=edition.emoji,
        lead=lead,
        site_url=site_url(env),
        date=date,
    )


async def publish_edition(
    edition_key: str,
    lead: Mapping[str, Any],
    *,
    sender: Sender,
    ledger: DeliveryLedger,
    env: Mapping[str, str] | None = None,
    date: str | None = None,
    config: DeliveryConfig | None = None,
    use_gopass: bool = True,
    sleep: Callable[[float], Awaitable[None]] | None = None,
) -> DeliveryReport:
    """Render and deliver one edition's single post, idempotently."""
    edition = get_edition(edition_key)
    day = date or day_key()
    decision: dict[str, Any] = {
        **dict(lead),
        "slug": lead.get("slug") or f"{edition.slug}-{day}",
        "title": edition_title(edition, env),
        "lanes": list(edition_lanes(env)),
        "big_story": False,
    }
    plan = plan_delivery([decision], day=day, ledger=ledger, env=env)

    def _render(post: PlannedPost) -> TelegramPayload:
        return render_edition(edition, post.decision.raw, env=env, date=day)

    return await deliver(
        plan,
        sender=sender,
        ledger=ledger,
        day=day,
        render=_render,
        env=env,
        config=config,
        use_gopass=use_gopass,
        sleep=sleep,
    )


__all__ = [
    "DEFAULT_SITE_URL",
    "EDITION_LANES_ENV",
    "EDITIONS",
    "Edition",
    "SITE_URL_ENV",
    "edition_lanes",
    "edition_title",
    "get_edition",
    "next_run",
    "publish_edition",
    "render_edition",
    "schedule",
    "site_url",
]
