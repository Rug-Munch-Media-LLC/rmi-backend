# import-linter configuration — rmi-backend
# Enforces layered architecture: routers → services → models → db
# Blocks CI if a layer imports from a higher layer (circular dependency)
# or if a router bypasses services to access DB directly.
#
# Install: pip install import-linter
# Run: lint-imports
# Docs: https://import-linter.readthedocs.io/

[importlinter]
root_package = app

# ── Contract 1: Layered architecture ──────────────────────────────────
# Dependencies flow DOWN only. Never reverse. Never skip layers.
[importlinter:contract:layers]
unmatched_ignore_imports_alerting = none
name = Layered architecture (routers → services → models → db)
type = layers
layers =
    app.routers
    app.api
    app.services
    app.domains
    app.middleware
    app.models
    app.db
    app.db_client
    app.core
ignore_imports =
    # ── LEGACY x402-billing slice — see TECH_DEBT.md #import-boundaries ──
    # The x402 billing domain still reaches UP into app.routers for
    # enforcement/catalog/tool-registry symbols. Not refactored in this pass:
    # planned move is tool registry + pricing catalog DOWN into
    # app.domains.billing.x402 (see TECH_DEBT.md entry dated 2026-09-07).
    app.domains.billing.x402.tools.integration.payments -> app.routers.x402_enforcement
    app.domains.x402.service -> app.routers.x402_catalog
    app.domains.x402.service -> app.routers.x402_enforcement
    app.domains.x402.middleware -> app.routers.x402_enforcement
    app.domains.billing.x402.payment_verifier -> app.routers.x402_middleware
    app.domains.billing.x402.payment_verifier -> app.routers.x402_dashboard
    app.domains.billing.x402.pricing_catalog -> app.routers._expanded_tools
    app.domains.billing.x402.pricing_catalog -> app.routers.x402_tools
    app.domains.billing.x402.pricing_catalog -> app.routers.x402_databus_tools
    app.domains.billing.x402.tier_resolver -> app.routers.developer_tier
    app.domains.billing.x402.shared_data -> app.routers._expanded_aliases
    app.domains.billing.x402.tools.integration.utils -> app.routers.x402_enforcement
    app.domains.billing.x402.tools.integration.utils -> app.routers.x402_enrichment
    app.domains.billing.x402.tools.integration.core -> app.routers.x402_enforcement
    app.domains.billing.x402.tools.integration.core -> app.tool_catalog
    app.domains.billing.x402.tools.token_tools -> app.fallback_engine
    app.domains.billing.x402.tools.deployer_tools -> app.whale_accumulation
    # ── SCOPED, EXPIRING (2026-11-30) — pre-existing, blocks every push ──
    # Both are lazy composition imports: the domain assembles a router at
    # mount time instead of the app doing it. Root-cause fix is to move the
    # mount into app/main (or app.api.composition); not attempted in this
    # pass because it reorders startup wiring. Owner: backend-lead.
    #   app/domains/chat/mount.py:54      -> legacy chat router alias
    #   app/domains/premium/service.py:66 -> scanner response formatter
    app.domains.chat.mount -> app.routers.chat
    app.domains.premium.service -> app.routers.unified_scanner_router
    app.core.payment_challenge -> app.domains.billing.x402_exact.challenge
# ── Contract 2: No router → DB direct access ─────────────────────────
# Routers must NOT import from db or db_client directly.
# They must go through services or domains.
[importlinter:contract:no-router-db]
unmatched_ignore_imports_alerting = none
name = Routers must not access DB directly
type = forbidden
source_modules =
    app.routers
forbidden_modules =
    app.db
    app.db_client
ignore_imports =
    # Admin routers are allowed direct DB access (special case)
    app.routers.admin -> app.db
    # Routers.auth reaches the DB only through the sanctioned service-layer
    # accessor app.services.auth_db — the single chokepoint that keeps
    # routers off app.db_client (the accessor is the only db_client importer).
    app.routers.auth -> app.services.auth_db

# ── Contract 3: No circular imports within services ─────────────────
# Services should not import from each other. Use dependency injection.
[importlinter:contract:no-service-circular]
unmatched_ignore_imports_alerting = none
name = No circular imports between service modules
type = forbidden
source_modules =
    app.services
forbidden_modules =
    app.routers
    app.api
ignore_imports =
    app.services.* -> app.services.common.*

# ── Contract 4: Core is the lowest layer ─────────────────────────────
# Core (config, security, deps) must not import from any higher layer.
[importlinter:contract:core-is-lowest]
unmatched_ignore_imports_alerting = none
name = Core must not import from higher layers
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.routers
    app.api
    app.services
    app.domains
    app.models
    app.db
    app.db_client
    app.middleware
ignore_imports =
    # ── SCOPED, EXPIRING (2026-11-30) — pre-existing, blocks every push ──
    # app/core/payment_challenge.py:24 imports the x402-exact accepts builder
    # from the billing domain. Correct fix: move the wire-shape primitive
    # (build_accepts + its NETWORK_BASE/USDC_BASE constants) DOWN into
    # app/core/x402_exact_accepts.py and have the domain re-export it.
    # Deferred: it re-lays a payment primitive and is not in this lane.
    # Owner: backend-lead.
    app.core.payment_challenge -> app.domains.billing.x402_exact.challenge
