[importlinter]
root_package = app

[importlinter:contract:domains-independence]
name = Domain packages are independent (no cross-domain imports)
type = independence
modules =
    app.domains

[importlinter:contract:core-foundation]
name = Core never imports features (core is foundational)
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.domains
    app.routers
ignore_imports =
    # KNOWN DEBT (2026-08-21): DI convenience singletons in core.
    # TODO(degodding-phase-4): move to feature-side registration.
    app.core.dependencies -> app.domains.scanner.unified
    app.core.dependencies -> app.domains.wallet.unified_wallet_scanner
    app.core.lifespan -> app.databus.core
    app.core.middleware -> app.routers.x402_advanced_tools
