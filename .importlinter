[importlinter]
include_external_packages = True
root_package = app

[importlinter:contract:domains-independence]
name = Domain packages are independent (no cross-domain imports)
type = independence
modules =
    app.domains

[importlinter:contract:core-foundation]
name = Core never imports features (core is foundational)
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.domains
    app.routers
ignore_imports =
    # KNOWN DEBT (2026-08-21): remaining cross-layer conveniences.
    # TODO(degodding-phase-4): lifespan databus init + middleware x402 mount.
    app.core.lifespan -> app.databus.core
    app.core.middleware -> app.routers.x402_advanced_tools

# Wire-in from standards/import-linter.contract.yaml (2026-08-30).
# `rag-via-client-only` is wired below (2026-08-30). Import-linter rejects
# external-package SUBPACKAGES as forbidden modules, so it forbids the whole
# top-level `rugbrain` package (which, being in the same wheel/tree, covers the
# internal submodules) and requires `include_external_packages = True` above.
# Verified green: app/rag consumes rugbrain via app.integrations.rugbrain_client only.
[importlinter:contract:scanner-via-adapter-only]
name = Backend re-exports scanner adapters, never re-implements
type = forbidden
source_modules =
    app.domains.scanner
forbidden_modules =
ignore_imports =

[importlinter:contract:rag-via-client-only]
name = Backend consumes rugbrain through the HTTP client only (never internals)
type = forbidden
source_modules =
    app.rag
forbidden_modules =
    rugbrain
ignore_imports =
