# RMI Backend — Environment Variables
# ====================================
# Copy this to .env and fill in real values for local dev.
# DO NOT commit .env — it's in .gitignore.
#
# For production, use .env.production.example as the template.
# Secrets MUST be set via environment variables or gopass.

# ════════════════════════════════════════════════════════════
# RUNTIME
# ════════════════════════════════════════════════════════════
ENVIRONMENT=dev
LOG_LEVEL=INFO
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ════════════════════════════════════════════════════════════
# DATABASE / CACHE
# ════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://rmi:rmi@localhost/rmi
# Sync Postgres URL for Alembic migrations (no async driver)
ALEMBIC_DATABASE_URL=postgresql://rmi:rmi@localhost/rmi
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_CACHE_URL=redis://localhost:6379/1

# ════════════════════════════════════════════════════════════
# CLICKHOUSE
# ════════════════════════════════════════════════════════════
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=rmi
CLICKHOUSE_PASSWORD=

# ════════════════════════════════════════════════════════════
# AUTH  [MANDATORY in production]
# ════════════════════════════════════════════════════════════
JWT_SECRET= # MANDATORY — generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRE_MINUTES=1440
RMI_AUTH_TOKEN= # MANDATORY — X-API-Key shared secret. Generate with: openssl rand -hex 32
RMI_INTERNAL_KEY= # MANDATORY — internal service key. Generate with: openssl rand -hex 32
DEV_BYPASS_AUTH=false
TOTP_ISSUER=RugMunch Intelligence

# ════════════════════════════════════════════════════════════
# CORS
# ════════════════════════════════════════════════════════════
CORS_ORIGINS=["https://rugmunch.io","https://www.rugmunch.io","http://localhost:5173"]

# ════════════════════════════════════════════════════════════
# RATE LIMITING
# ════════════════════════════════════════════════════════════
RATE_LIMIT_PER_MINUTE=100
RATE_LIMITER_REDIS_DB=4
RATE_LIMIT_SALT= # RECOMMENDED — openssl rand -hex 16

# ════════════════════════════════════════════════════════════
# AI PROVIDERS
# ════════════════════════════════════════════════════════════
INFINITY_URL=http://localhost:8001
OPENROUTER_API_KEY=
HUGGINGFACE_TOKEN=
# LiteLLM proxy runs on the HOST in host-network mode; the backend container
# reaches it via the docker bridge gateway (172.22.0.1), not localhost.
LITELLM_API_BASE=http://172.22.0.1:4000/v1
LITELLM_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_API_KEY=

# ── OpenCode Zen multi-account router (rugmunchbot chat_ai) ────────────────
# 3x DeepSeek V4 Flash Free accounts, each behind its OWN rotating Webshare
# residential proxy IP → ~3k free chats/day with 429/403/timeout failover.
# When ZEN_ACCOUNTS (and ZEN1_URL/...) are unset, the bot keeps the legacy
# single-account path (ZEN_CHAT_URL egress proxy, ~10 chats/day).
#
# ZEN_ACCOUNTS is a JSON array (full OpenAI-compatible chat/completions URL
# per account). Placeholder proxy creds — replace with real Webshare creds:
# ZEN_ACCOUNTS=[{"name":"zen1","base_url":"https://zen.example/v1/chat/completions","api_key":"sk-placeholder-1","proxy":"http://user:pass@proxy-ip-1:port"},{"name":"zen2","base_url":"https://zen.example/v1/chat/completions","api_key":"sk-placeholder-2","proxy":"http://user:pass@proxy-ip-2:port"},{"name":"zen3","base_url":"https://zen.example/v1/chat/completions","api_key":"sk-placeholder-3","proxy":"http://user:pass@proxy-ip-3:port"}]
# Alternative flat form (mutually exclusive with ZEN_ACCOUNTS): ZEN1_URL +
# ZEN1_KEY + ZEN1_PROXY, ZEN2_URL + ZEN2_KEY + ZEN2_PROXY, ... (up to ZEN10).
# ZEN_PROXY_URL is the shared proxy fallback for accounts without their own.
# ZEN_COOLDOWN_S=60   # seconds a rate-limited account+IP stays out of rotation
# ZEN_MAX_RETRIES=1   # extra account attempts per request (0 = 1 attempt only)
ZEN_ACCOUNTS=

# ════════════════════════════════════════════════════════════
# OAUTH
# ════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://rugmunch.io/api/v1/auth/google/callback

# ════════════════════════════════════════════════════════════
# OBSERVABILITY
# ════════════════════════════════════════════════════════════
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
SENTRY_DSN=
# GlitchTip DSN — get from GlitchTip UI: Project Settings → Client Keys
# Uses standard Sentry SDK. Compatible with init_error_tracking().
GLITCHTIP_DSN=
OTEL_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# ════════════════════════════════════════════════════════════
# LISTMONK (email newsletters)
# ════════════════════════════════════════════════════════════
LISTMONK_URL=http://127.0.0.1:9001/api
LISTMONK_USER=
LISTMONK_PASS=

# ════════════════════════════════════════════════════════════
# EMAIL (transactional — rmi-mail SMTP)
# ════════════════════════════════════════════════════════════
RMI_SMTP_HOST=mail.rugmunch.io
RMI_SMTP_PORT=587
RMI_SMTP_USER=noreply@rugmunch.io
RMI_SMTP_PASS=
RMI_SMTP_FROM=RugMunch <noreply@rugmunch.io>

# [DEPRECATED] Gmail SMTP fallback — will be removed
GMAIL_APP_PASSWORD=

# ════════════════════════════════════════════════════════════
# EXTERNAL APIs
# ════════════════════════════════════════════════════════════
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=
HELIUS_API_KEY=
APIFY_API_TOKEN=
BASESCAN_API_KEY=
MORALIS_API_KEY=
BITQUERY_API_KEY=
LUNARCRUSH_API_KEY=
CHAINABUSE_API_KEY=
WEBACY_API_KEY=
GMGN_API_KEY=
BSCSCAN_KEY=
ALCHEMY_KEY=

# ════════════════════════════════════════════════════════════
# SUPABASE
# ════════════════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ════════════════════════════════════════════════════════════
# TELEGRAM BOT
# ════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=7075336557

# Telegram news sweep (channels/telegram_news.py) — channel source selection.
# Auto-discovery (default on) reads the account's own followed/member public
# channels via Telethon get_dialogs(). When disabled or empty, the sweep falls
# back to RMI_TG_NEWS_CHANNELS (comma/pipe-separated @handles), then defaults.
RMI_TG_NEWS_AUTO_DISCOVER=true
#RMI_TG_NEWS_CHANNELS=cointelegraph|wublockchain

# Headless MTProto client credentials for the sweep (Telethon user session).
# Resolved gopass-first: rmi/telegram/api_id + rmi/telegram/api_hash MUST exist
# in the store; rmi/telegram/phone is REQUIRED for the sweep to return data
# (the alerts/daily domains share the same headless client). Env fallbacks:
RMI_TG_API_ID=
RMI_TG_API_HASH=
RMI_TG_PHONE=

# News-channel importance gating + cadence (channels/importance.py).
# Every swept article is persisted; only articles scoring above the rerank
# threshold are posted to the news channel. Cadence accepts fractions:
# RMI_CHANNEL_NEWS_INTERVAL_HOURS=0.5 → every 30min (~2x/hour); the TG sweep
# default is 30min (RMI_CHANNEL_TG_NEWS_INTERVAL_MINUTES).
RMI_NEWS_IMPORTANCE_THRESHOLD=0.4
#RMI_NEWS_IMPORTANCE_QUERIES=major market-moving event in crypto|hack or exploit steals user funds
#RMI_NEWS_FOCUS_KEYWORDS=etf|whale|regulation
#RMI_NEWS_IMPORTANCE_MAX_BATCH=100
#RMI_CHANNEL_NEWS_INTERVAL_HOURS=0.5
#RMI_CHANNEL_TG_NEWS_INTERVAL_MINUTES=30
# Feed the swept TG news into RAG (news_v2, the collection get_news searches).
# Default on; disable to keep the news lane out of RAG entirely.
RMI_TG_NEWS_RAG=true

# Personal channel (@cryptorugmuncher) — channels/personal_channel.py.
# Posts ONLY the "bigger stories": reranker importance >= the stricter
# threshold below, posted as operator-voice captions and cross-posted to the
# Ghost blog. Master switch is OFF by default (opt-in).
#RMI_PERSONAL_CHANNEL_ENABLED=false
#RMI_PERSONAL_CHANNEL_INTERVAL_MINUTES=180
#RMI_PERSONAL_CHANNEL_THRESHOLD=0.7
#RMI_PERSONAL_CHANNEL_POST_LIMIT=3
#RMI_PERSONAL_CHANNEL_GHOST_ENABLED=true
#RMI_PERSONAL_CHANNEL_ID=
# Ghost Admin API for the personal-channel cross-post (Admin API key:
# secrets-store ghost-admin-api-key, format <id>:<secret>).

# Channel scheduler hardening (channels/scheduler.py + scheduler_state.py).
# RMI_POST_RETRIES — retries after a failed channel post (exponential backoff
# 0.5s, 1s, 2s, ... capped at 8s) before logging + dropping. Default 2.
# RMI_CHANNELS_STATE_TTL_SECONDS — how long the Redis durable dedupe sets
# survive (default 259200 = 72h; must exceed the longest channel interval).
#RMI_POST_RETRIES=2
#RMI_CHANNELS_STATE_TTL_SECONDS=259200

#GHOST_ADMIN_API_URL=https://blog.rugmunch.io
#GHOST_ADMIN_API_KEY=

# ════════════════════════════════════════════════════════════
# BLOCKCHAIN RPC
# ════════════════════════════════════════════════════════════
RETH_URL=https://ethereum-rpc.publicnode.com
ALCHEMY_KEY=
SOLSCAN_URL=https://api-v2.solscan.io/v2

# ════════════════════════════════════════════════════════════
# MEMGRAPH / NEO4J
# ════════════════════════════════════════════════════════════
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ════════════════════════════════════════════════════════════
# REDPANDA
# ════════════════════════════════════════════════════════════
REDPANDA_BROKER=rmi-redpanda:9092

# ════════════════════════════════════════════════════════════
# PRYSCRAPER
# ════════════════════════════════════════════════════════════
PRYSCRAPER_URL=http://pry:8002
PRY_API_KEY=

# ════════════════════════════════════════════════════════════
# X402 PAYMENT
# ════════════════════════════════════════════════════════════
X402_VERIFY_URL=http://localhost:8000/api/v1/x402/verify


# ════════════════════════════════════════════════════════════
# SCAN LIMITS
# ════════════════════════════════════════════════════════════
FREE_SCAN_LIMIT=5
PRO_SCAN_LIMIT=100
ELITE_SCAN_LIMIT=0
RAG_EMBEDDING_DIM=0
WALLET_VAULT_PASSWORD=
RAG_COLLECTIONS=scam_intel,deployer_history,wallet_labels,contract_audit,phishing_db
LLAMA_RAG_ENABLED=false
PRICING_URL=https://rugmunch.io/pricing

# ════════════════════════════════════════════════════════════
# MATRIX / CONDUIT (Standardized Private Chat)
# ════════════════════════════════════════════════════════════
MATRIX_HOMESERVER=http://127.0.0.1:8448
MATRIX_SERVER_NAME=rugmunch.io
MATRIX_BOT_USER=@rmi-bot:rugmunch.io
MATRIX_BOT_TOKEN=
MATRIX_BOT_PASSWORD=
MATRIX_ADMIN_TOKEN=

# ════════════════════════════════════════════════════════════
# INFRASTRUCTURE — Docker host & service endpoints
# ════════════════════════════════════════════════════════════
DOCKER_HOST_IP=172.17.0.1
# Docker host gateway IP. Used as default for services like
# VAULT_ADDR. Override if your Docker bridge
# uses a different subnet.

NEWS_PROXY_HOST=43.153.99.140
# Public proxy IP used for RSS feed rotation. Set to your
# proxy server's external IP or hostname.

GHOST_URL=http://ghost:2368
# Ghost CMS URL for publishing daily intel and news content.
# In Docker, use container name; for external, use full URL.

VAULT_ADDR=http://localhost:8200
# HashiCorp Vault address for secrets management.

# ════════════════════════════════════════════════════════════
# QDRANT
# ════════════════════════════════════════════════════════════
# QDRANT_API_KEY=<generate-a-long-random-string>
# Qdrant API key (optional). When set, Qdrant requires this key
# for all API access. The host port binds to 127.0.0.1 only, and
# the app reaches Qdrant over the internal Docker network, so the
# key is defense-in-depth for any host-level exposure.

# ════════════════════════════════════════════════════════════
# WEBHOOKS
# ════════════════════════════════════════════════════════════
WEBHOOK_ENGINE_ENABLED=true
# Master switch for the poll-based webhook engine. Set to false to
# disable all webhook event polling and delivery without removing
# subscriptions. Defaults to true when unset.

# ── Phoenix (Arize) — RAG observability ──────────────────────────────
# PHOENIX_ENABLED must be "true" to export RAG spans. Endpoint is the
# OTLP gRPC receiver; inside the Docker network use http://phoenix:4317.
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://phoenix:4317
PHOENIX_PROJECT=rugmunch-rag
PHOENIX_UI_URL=http://localhost:6006
