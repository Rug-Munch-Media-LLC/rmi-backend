FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

RUN groupadd -r rmi && useradd -r -g rmi rmi

COPY --from=builder /root/.local /usr/local

WORKDIR /app
COPY app/ /app/app/

USER rmi

# Worker health: verifies the process is running by checking the worker PID
# In a container orchestration context, this confirms the process is alive.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import os,sys; sys.exit(0) if os.path.exists('/proc/self/status') else sys.exit(1)"]

CMD ["python", "-m", "app.temporal.worker"]

# Security hardening (applied at runtime):
#   --read-only                    Makes rootfs read-only
#   --cap-drop=ALL                 Drops all Linux capabilities
#   --security-opt=no-new-privileges
#   --tmpfs /tmp
